{
  "name": "@oai/artifact-tool",
  "version": "2.8.93",
  "private": true,
  "type": "module",
  "dependencies": {
    "skia-canvas": "^3.0.6",
    "@oai/walnut": "0.1.258"
  },
  "exports": {
