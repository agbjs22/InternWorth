    "./artifact-session": "./dist/artifact-session/index.mjs",
    "./artifact-session/prepare": "./dist/artifact-session/prepare.mjs",
    "./artifact-session/service": "./dist/artifact-session/service.mjs",
    "./artifact-session/host-client": "./dist/artifact-session/host-client.mjs",
    "./artifact-session/host-daemon": "./dist/artifact-session/host-daemon.mjs",
    "./session-mcp": "./dist/artifact-session-mcp/server.mjs",
